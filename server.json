{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.mambabuilt/mcp-email-verifier",
  "description": "Verify email lists on your own ZeroBounce, NeverBounce, MillionVerifier, BounceBan, or Reoon key.",
  "version": "1.0.0",
  "repository": {
    "url": "https://github.com/mambalabsdev/mcp-email-verifier",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mambalabsdev/mcp-email-verifier",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APIFY_TOKEN",
          "description": "Apify API token from https://console.apify.com/account/integrations",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "EMAIL_VERIFIER_API_KEY",
          "description": "Your own API key for ZeroBounce, NeverBounce, MillionVerifier, BounceBan, or Reoon.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
